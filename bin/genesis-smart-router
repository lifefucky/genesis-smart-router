#!/usr/bin/env ruby
# frozen_string_literal: true

PROJECT_ROOT = File.expand_path("..", __dir__)

$LOAD_PATH.unshift(File.join(PROJECT_ROOT, "lib"))

require "smart_router"
require "optparse"

def usage
  warn "Usage: bin/genesis-smart-router [QUEUE_PATH] [options]"
  warn "  QUEUE_PATH defaults to data/operations_queue_test.json relative to project root"
  warn "Options:"
  warn "  -p, --policy-pack PACK       Specify policy pack version to use"
end

options = {
  policy_pack: nil
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/genesis-smart-router [QUEUE_PATH] [options]"

  opts.on("-p", "--policy-pack PACK", "Specify policy pack version to use") do |p|
    options[:policy_pack] = p
  end

  opts.on("-h", "--help", "Prints this help") do
    warn opts
    exit 0
  end
end

begin
  parser.parse!(ARGV)
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn "Ошибка параметров CLI: #{e.message}"
  warn parser
  exit 1
end

begin
  queue_arg = ARGV[0]
  original_pwd = Dir.pwd

  queue_path =
    if queue_arg.nil? || queue_arg.strip.empty?
      File.join(PROJECT_ROOT, "data/operations_queue_test.json")
    else
      File.expand_path(queue_arg, original_pwd)
    end

  Dir.chdir(PROJECT_ROOT)

  providers_path = File.join(PROJECT_ROOT, SmartRouter::DEFAULT_PROVIDERS_PATH)
  history_path = File.join(PROJECT_ROOT, SmartRouter::DEFAULT_HISTORY_PATH)
  root_dir = PROJECT_ROOT

  result = SmartRouter.batch_run(
    queue_path: queue_path,
    providers_path: providers_path,
    history_path: history_path,
    root_dir: root_dir,
    policy_pack: options[:policy_pack]
  )

  decisions = Array(result["decisions"])
  decisions_path = result["decisions_path"]
  report_path = result["report_path"]

  puts "Успех: обработано #{decisions.length} операций."
  puts "Файлы записаны:"
  puts "  routing_decisions_test.json -> #{decisions_path}"
  puts "  routing_report_test.json    -> #{report_path}"
  exit 0
rescue SmartRouter::InputError => e
  warn "Ошибка входных данных: #{e.message}"
  warn "Файлы routing_decisions_test.json и routing_report_test.json не были созданы или изменены."
  exit 1
rescue StandardError => e
  warn "Неожиданная ошибка: #{e.class}: #{e.message}"
  usage
  exit 1
end

